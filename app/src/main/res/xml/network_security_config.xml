<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers are often plain http on a LAN or VPN, so cleartext is allowed.
     Use https when JellyGlance is reachable from the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
